# Flask Application Config
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
APP_BASE_URL=http://127.0.0.1:5000

# Firebase Project Configuration
FIREBASE_PROJECT_ID=atomic-north-accommodation-hub
# Path to service account JSON (recommended for local development)
GOOGLE_APPLICATION_CREDENTIALS=../service-account.json
# Alternatively, inline service account JSON string (for Render / Docker / PaaS):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase Web Client SDK Configuration
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=atomic-north-accommodation-hub.firebaseapp.com
FIREBASE_APP_ID=1:758327271700:web:nestfinderweb001
FIREBASE_MESSAGING_SENDER_ID=758327271700

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=khan-developers
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_SIGNED_PRESET=accommodation_signed

# Session and Cookie Configuration
SESSION_COOKIE_DAYS=5
